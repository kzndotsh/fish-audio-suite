# Copy to .env (gitignored) and fill the keys.
#   cp .env.example .env
#   ./packages/voice/dev.sh --smoke
#   ./packages/voice/dev.sh
#
# How to read this file
#   NAME=value      active; this is what you set
#   # NAME=value    off; shows the default (or an alternative you can swap in)
#   Pick-one groups (marked "pick one") list the choices; uncomment exactly one.
#   Process env wins over this file. Nothing else is loaded.
#   Every key is listed with its default in packages/voice/README.md and
#   packages/proxy/README.md.

# ══ 1. Keys and voice ═══════════════════════════════════════════════════════
# Required for --smoke and the voice loop
FISH_API_KEY=
FISH_VOICE_ID=


# ══ 2. LLM (voice loop only) ════════════════════════════════════════════════
# Pick one provider. FISH_LLM_API_KEY, when set, works for every provider and
# wins over the provider keys below. Any other host reads OPENAI_API_KEY.

# [A] OpenRouter (pick one)
# FISH_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=                # used only for this provider
# FISH_LLM_MODEL_OPENROUTER=         # keeps one .env usable for several providers
# FISH_LLM_BASE=https://openrouter.ai/api/v1

# [B] Experiential (pick one)
# FISH_LLM_PROVIDER=experiential
# EXPLABS_API_KEY=                   # xpl_..., used only for this provider
# FISH_LLM_MODEL_EXPERIENTIAL=

# [C] Any OpenAI-compatible server: a hosted API, Ollama, a self-hosted one (pick one)
# FISH_LLM_BASE=http://127.0.0.1:11434/v1
FISH_LLM_API_KEY=
FISH_LLM_MODEL=

# Tuning, any provider
# FISH_LLM_TEMPERATURE=0.8
# FISH_LLM_TIMEOUT=120
# FISH_LLM_MAX_TOKENS=1200
# FISH_LLM_CONTINUE=0
# FISH_LLM_REASONING_EFFORT=low      # none|minimal|low|medium|high|max, openai backend only

# OpenRouter only
# FISH_LLM_NITRO=0
# FISH_LLM_PROVIDER_SORT=latency     # latency|throughput|price|off
# FISH_LLM_REFERER=
# FISH_LLM_TITLE=
# FISH_LLM_CATEGORIES=


# ══ 3. Fish Audio: speech and transcription (voice and proxy) ═══════════════
# FISH_BASE=https://api.fish.audio
# FISH_TTS_MODEL=s2.1-pro
# FISH_LATENCY=normal                # normal|balanced
# FISH_SPEED=1
# FISH_VOLUME=0
# FISH_TEMPERATURE=0.7
# FISH_TOP_P=0.7
# FISH_REPETITION_PENALTY=1.2
# FISH_CHUNK_LENGTH=200
# FISH_MIN_CHUNK_LENGTH=50
# FISH_SAMPLE_RATE=44100
# FISH_ASR_LANGUAGE=en
# FISH_ASR_MODEL=transcribe-1-pro    # or transcribe-1


# ══ 4. Hearing you: speech recognition ══════════════════════════════════════
# Pick one: fish sends a clip when you stop; deepgram streams while you speak.
# FISH_VOICE_STT=fish
# FISH_VOICE_STT=deepgram

# Deepgram only
# DEEPGRAM_API_KEY=
# FISH_VOICE_DEEPGRAM_MODEL=flux-general-en
# FISH_VOICE_DEEPGRAM_REGION=global  # or eu, au, in: process the audio inside that region
# FISH_VOICE_EOT_THRESHOLD=0.7       # 0.5 to 1. Higher waits longer before calling the turn over
# FISH_VOICE_EAGER_EOT_THRESHOLD=0   # 0 is off. 0.3 to 0.9: start the reply early (more model calls)
# FISH_VOICE_STT_SAVE_DIR=           # a folder: save each streamed turn's audio as a WAV

# Where your voice starts and ends (both recognisers)
# FISH_VOICE_DEVICE=                 # input device, empty is the system default
# FISH_VOICE_VAD=1                   # 0-3, higher is pickier. 2 can stop sniffs and bumps interrupting a reply
# FISH_VOICE_SPEECH_FRAMES=4
# FISH_VOICE_MIN_RMS=200
# FISH_VOICE_PRE_PAD_FRAMES=20
# FISH_VOICE_MIN_VOICED_FRAMES=12
# FISH_VOICE_SILENCE_FRAMES=40       # quiet frames of 30 ms that end a turn (Fish path)
# FISH_VOICE_REPEAT_WINDOW=1.5       # seconds


# ══ 5. Sounding more human (all off by default, see the voice README) ═══════
# FISH_VOICE_TURN_CHECK=0            # 1: end the first clip on a short silence, and let the words decide if the turn is over
# FISH_VOICE_TURN_SILENCE_FRAMES=12  # quiet frames that end the first clip while the check is on
# FISH_VOICE_TURN_EXTEND_FRAMES=40   # quiet frames that end a continuation
# FISH_VOICE_TURN_EXTENSIONS=1       # continuations one turn may have: 1 or 2
# FISH_VOICE_HEAR_TONE=0             # 1, experimental: tell the model how you sounded, for that turn only
# FISH_VOICE_NORMALIZE_LOUDNESS=0    # 1: bring each reply to a steady level before it plays
# FISH_VOICE_LOUDNESS_TARGET_DB=-18  # dB below full scale, -40 to -6


# ══ 6. Speaking: replies, cues and text rules ═══════════════════════════════
# FISH_VOICE_STREAM_TTS=0            # 1 speaks while the LLM is still writing
# FISH_VOICE_HISTORY_TURNS=20
# FISH_VOICE_SYSTEM_PROMPT=          # the whole prompt, used as written
# FISH_VOICE_SYSTEM_PROMPT_FILE=     # or a character file; the voice rules follow it

# Roleplay helpers, off by default (voice and proxy, except DIALOGUE_ONLY: proxy only)
# FISH_TTS_MOOD_LEAD=0
# FISH_TTS_CUES=official             # official: map or drop cues Fish does not list. free: send them as written
# FISH_TTS_DROP_NARRATION=0
# FISH_TTS_DIALOGUE_ONLY=0


# ══ 7. Playback, interruption and echo ══════════════════════════════════════
# FISH_VOICE_PLAYBACK=sounddevice
# FISH_VOICE_OUTPUT_LATENCY=auto     # auto, low or high: a bigger buffer stops clicks (auto is high in --tui)
# FISH_VOICE_FADE_MS=4               # fade at each sentence start and end, so it does not click. 0 = off
# FISH_VOICE_COOLDOWN=0.8
# FISH_VOICE_BLEED_DELAY=0.9

# Barge-in: talking over a reply
# FISH_VOICE_BARGE_FRAMES=10
# FISH_VOICE_BARGE_RMS=220
# FISH_VOICE_BARGE_PLAYING_GAIN=2.2

# Echo cancellation
# FISH_VOICE_AEC=1
# FISH_VOICE_AEC_WET=0.85
# FISH_VOICE_AEC_BLEED_DELAY=0.3


# ══ 8. Logging ══════════════════════════════════════════════════════════════
# FISH_VOICE_DEBUG=1                 # 2 or trace adds heartbeats and raw traffic
# FISH_VOICE_LOG_DIR=                # a folder: write a complete log of each run to a new file in it


# ══ 9. Proxy (fish-audio-suite-proxy) ═══════════════════════════════════════
# Put FISH_API_KEY above or in the process env.
# FISH_PROXY_HOST=127.0.0.1
# FISH_PROXY_PORT=8849
# FISH_PROXY_API_KEYS=               # comma list; clients send one as a Bearer token
# FISH_PROXY_MAX_BODY_BYTES=26214400
# FISH_PROXY_MAX_INPUT_CHARS=4096
# FISH_PROXY_LOG_TEXT=0

# Output
# FISH_TTS_FORMAT=mp3
# FISH_MP3_BITRATE=128
# FISH_QUALITY_GUARD=0
# FISH_PROXY_TTS_ALIASES=            # alias=model,alias=model
# FISH_PROXY_ASR_STRIP_SPEAKERS=1
# FISH_PROXY_ASR_STRIP_CUES=0

# Retries, timeouts and server
# FISH_PROXY_RETRY_ATTEMPTS=5
# FISH_PROXY_RETRY_DEADLINE=90
# FISH_PROXY_ASR_TIMEOUT=900         # transcription read timeout and deadline
# FISH_PROXY_CONNECT_TIMEOUT=10
# FISH_PROXY_READ_TIMEOUT=120
# FISH_PROXY_POOL_TIMEOUT=5
# FISH_PROXY_WORKERS=1
# FISH_PROXY_KEEP_ALIVE=5
# FISH_PROXY_GRACEFUL_SHUTDOWN=120   # docker stop needs --stop-timeout above this
# FISH_PROXY_LIMIT_CONCURRENCY=      # unset means no cap
