# Copy to .env (gitignored) and fill keys.
#   cp .env.example .env
#   ./packages/voice/dev.sh --smoke
#   ./packages/voice/dev.sh
# Process env wins over this file. Nothing else is loaded.

# Required for --smoke and duplex
FISH_API_KEY=
FISH_VOICE_ID=

# Required for duplex (mic loop) only
OPENROUTER_API_KEY=
FISH_LLM_MODEL=

# Optional TTS / ASR
# FISH_BASE=https://api.fish.audio
# FISH_TTS_MODEL=s2.1-pro
# FISH_LATENCY=normal
# FISH_SPEED=1.05
# FISH_ASR_LANGUAGE=en
# FISH_PLAYBACK=sounddevice
# FISH_VOICE_DEVICE=
# FISH_SYSTEM_PROMPT=

# Barge / VAD (read at record / BargeGate construct)
# FISH_VOICE_VAD=1
# FISH_VOICE_SPEECH_FRAMES=4
# FISH_VOICE_MIN_RMS=200
# FISH_VOICE_PRE_PAD=20
# FISH_VOICE_COOLDOWN=0.8
# FISH_VOICE_BLEED_DELAY=0.9
# FISH_VOICE_BARGE_FRAMES=10
# FISH_VOICE_BARGE_RMS=220
# FISH_VOICE_MIN_VOICED=12
# FISH_VOICE_AEC=1
# FISH_VOICE_AEC_WET=0.85
# FISH_VOICE_AEC_BLEED=0.1
# FISH_VOICE_DEBUG=1
