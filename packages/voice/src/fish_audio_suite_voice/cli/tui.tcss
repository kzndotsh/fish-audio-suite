/* Stylesheet for the fish-voice terminal app. Layout, top to bottom: the title line, the
   conversation, the state line, the composer, then the footer. */

Screen {
    layout: vertical;
}

#header {
    height: 1;
    padding: 0 1;

    #title {
        width: 1fr;
        text-style: bold;
    }

    #keys-hint {
        width: auto;
        color: $text-muted;
    }
}

#conversation {
    height: 1fr;
    padding: 0 1;

    .message {
        margin-bottom: 1;
    }

    .note {
        color: $text-muted;
        text-style: italic;
    }

    /* Every row keeps the column the selection bar uses, and a live "›" line sits right on
       its reply, so nothing shifts when the recorded turn takes their place. */
    .message {
        padding: 0 1 0 0;
        border-left: blank;
    }

    .message.you {
        margin-bottom: 0;
    }

    /* A reply sits under the user's line, indented, and its wrapped lines keep the indent. */
    .reply,
    .turn-note,
    .actions {
        padding-left: 2;
    }

    .turn.hidden {
        opacity: 50%;
    }

    .actions {
        display: none;
        margin-top: 1;
    }

    &:focus .turn.selected {
        border-left: thick $primary;
        background: $boost;

        .actions {
            display: block;
        }
    }
}

.message.pending {
    opacity: 70%;
}

/* The state line: a glyph and a word in the state's colour, a small level meter while
   listening or speaking, and a plain hint. */
#state-line {
    height: 1;
    padding: 0 1;

    #state {
        width: auto;

        &.listening {
            color: $text-success;
        }

        &.thinking {
            color: $text-warning;
        }

        &.speaking {
            color: $text-accent;
        }

        &.muted,
        &.idle {
            color: $text-muted;
        }

        &.ended {
            color: $text-error;
        }
    }

    #meter {
        width: 10;
        margin-left: 2;
    }

    #hint {
        width: 1fr;
        margin-left: 2;
        color: $text-muted;
    }
}

#line {
    height: auto;
    background: $background;
    border: round $panel;

    &:focus {
        border: round $accent;
    }
}

/* The dialogs (cli/chat_screens.py). */
EditReplyScreen,
ChatPicker,
KeysScreen {
    align: center middle;
}

#edit-box,
#picker-box,
#keys-box {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 80%;
    border: round $primary;
    border-title-color: $text-primary;
    background: $surface;
    padding: 0 1;

    .dialog-hint {
        color: $text-muted;
        margin-bottom: 1;
    }
}

#keys-box {
    max-width: 64;
}

#edit-text {
    height: 12;
}

#chats {
    height: auto;
    max-height: 20;
    border: none;
}

/* Diagnostics (cli/diagnostics.py). */
#diag-head {
    height: 1;
    padding: 0 1;

    #diag-title {
        width: auto;
        text-style: bold;
    }

    #diag-note {
        width: 1fr;
        margin-left: 2;
        color: $text-muted;
    }

    #diag-back {
        width: auto;
        color: $text-muted;
    }
}

DiagnosticsScreen {
    TabbedContent {
        height: 1fr;
    }

    TabPane {
        padding: 1 1 0 1;
    }

    #latency {
        margin-bottom: 1;
    }

    .dim {
        color: $text-muted;
    }

    #log {
        height: 1fr;
        background: $background;
    }
}

/* Too small: the screen carries .tiny (see VoiceApp.on_resize). */
#too-small {
    display: none;
    height: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-warning;
}

Screen.tiny {
    #conversation,
    #state-line {
        display: none;
    }

    #too-small {
        display: block;
    }
}

/* Scrollbars only when there is something to scroll, one cell wide, in the theme's colours.
   Log would otherwise always draw both tracks as black strips. */
Log,
Conversation {
    overflow: auto auto;
    scrollbar-size: 1 1;
    scrollbar-background: $background;
    scrollbar-background-hover: $background;
    scrollbar-background-active: $background;
    scrollbar-color: $secondary-muted;
    scrollbar-color-hover: $secondary;
    scrollbar-color-active: $primary;
}

/* A focused widget gets a lighter tint over its whole box by default, which includes the
   border cells and reads as a halo past the border. The border colour, or the selection
   bar, marks focus instead. */
#log,
#line,
#conversation {
    background-tint: transparent;

    &:focus {
        background-tint: transparent;
    }
}

/* Minimal: the key hints sit on the screen colour, with no bar or key backgrounds. */
Footer {
    background: $background;

    FooterKey,
    FooterKey .footer-key--key,
    FooterKey .footer-key--description {
        background: transparent;
    }
}
